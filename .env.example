# Copy this file to .env.local and add real values in your deployment settings.
# Never commit .env.local, Resend credentials, or Turnstile secrets.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@practicecaresource.com
# Must be a verified sender address in your Resend account.
CONTACT_FROM_EMAIL=
NEXT_PUBLIC_SITE_URL=
# Optional Cloudflare Turnstile protection. Configure BOTH keys together or leave BOTH empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
